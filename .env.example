# ─────────────────────────────────────────────────────────────────────────────
# PAYE (PayETH) Solana OFT — Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Solana deployer / developer keypair ──────────────────────────────────────
# This wallet is set as the initial `developer` AND the initial LayerZero OApp
# delegate during init_oft.  It can wire peers + configure endpoint/ULN/DVN
# immediately after deploy without requiring the treasury key.
#
# Set ONE of the following (not both):

# Option A: Base-58 private key (as exported from a wallet)
SOLANA_PRIVATE_KEY=

# Option B: Path to a JSON keypair file
SOLANA_KEYPAIR_PATH=~/.config/solana/id.json

# ── Treasury keypair (Koinon wallet — becomes the OFT admin) ─────────────────
# Must be a JSON keypair file.  On mainnet use a Squads multisig key.
# Only needed when running admin-only instructions (setAdmin, setOftConfig, etc.)
# or when promoting a new developer.  Not required for standard wiring.
TREASURY_KEYPAIR_PATH=

# ── Solana RPC endpoints ──────────────────────────────────────────────────────
# Defaults to public endpoints if not set; provide a premium RPC for mainnet.
RPC_URL_SOLANA=https://api.mainnet-beta.solana.com
RPC_URL_SOLANA_TESTNET=https://api.devnet.solana.com

# ── OFT Program ID ────────────────────────────────────────────────────────────
# Set after running `anchor keys sync -p paye-oft && anchor build`.
OFT_PROGRAM_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Wiring (wire.ts + ConfigureLz.s.sol)
# One chain pair per run — --remote-eid is required.
# ─────────────────────────────────────────────────────────────────────────────

# ── Single-pair wiring ────────────────────────────────────────────────────────
# Set these to wire one remote EID at a time:
#   npx ts-node app/scripts/wire.ts --cluster devnet --remote-eid 40161
#
# REMOTE_EID             = LayerZero EID of the peer chain (e.g. 40161)
# REMOTE_PAYE_ADDRESS    = EVM PAYEToken address on that chain (0x…)
# REMOTE_PEER_BYTES32    = raw bytes32 peer for non-EVM chains (takes precedence)
#                          e.g. for Solana → EVM: 0x + OFT Store pubkey as hex
REMOTE_EID=
REMOTE_PAYE_ADDRESS=
REMOTE_PEER_BYTES32=

# LayerZero EID reference:
#   Testnet:  Eth Sepolia 40161 | Base Sepolia 40245 | Linea Sepolia 40287 | Solana Devnet 40168
#   Mainnet:  Linea 30183       | Base 30184          | Ethereum 30101      | Solana 30168

# ── Optional: mock endpoint program ID (for local tests) ─────────────────────
MOCK_ENDPOINT_ID=76y77prsiCMvXMjuoZ5VRrhG5qYBrUMYTE5WgHqgjEn6

# ─────────────────────────────────────────────────────────────────────────────
# EVM side (Forge — only needed when running mixed EVM+Solana tasks)
# These mirror the variables used by ConfigureLz.s.sol.
# ─────────────────────────────────────────────────────────────────────────────
# LOCAL_PAYE_ADDRESS = PAYEToken on the EVM chain being configured
# REMOTE_EID         = shared with Solana side above
# REMOTE_PAYE_ADDRESS / REMOTE_PEER_BYTES32 = shared with Solana side above
LOCAL_PAYE_ADDRESS=
PRIVATE_KEY=
# or: MNEMONIC="word1 word2 ... word12"
